                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/404"
          q: {
            exist: [
              "referrer"
              "url"
            ]
          }
          s: [
            {
              lit: "404"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
