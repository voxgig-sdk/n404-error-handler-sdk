    }
    solutions: {
      h: "Solutions"
      n: "solutions"
      r: false
      sh: "Suggested solutions to fix the error"
      t: "`$ARRAY`"
    }
    timestamp: {
      fo: "date-time"
      h: "Timestamp"
      n: "timestamp"
